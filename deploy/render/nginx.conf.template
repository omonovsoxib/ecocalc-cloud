# Render: bitta ochiq port ($PORT). Nginx Ingress vazifasini bajaradi.
server {
  listen ${PORT};
  client_max_body_size 5m;
  location /api/auth/     { proxy_pass http://127.0.0.1:8002; }
  location /api/projects  { proxy_pass http://127.0.0.1:8003; proxy_read_timeout 30s; }
  location /api/calc      { proxy_pass http://127.0.0.1:8001; }
  location /api/reports/  { proxy_pass http://127.0.0.1:8004; }
  location = /healthz     { proxy_pass http://127.0.0.1:8001/healthz; }
  location /              { root /usr/share/nginx/html; try_files $uri /index.html; }
}
